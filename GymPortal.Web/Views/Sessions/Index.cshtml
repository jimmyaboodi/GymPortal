@model IEnumerable<GymPortal.Domain.Entities.Session>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}

<h1>Tillgängliga träningspass</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Pass</th>
            <th>Datum och Tid</th>
            <th>Instruktör</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var session in Model)
        {
            <tr>
                <td>@session.Name</td>
                <td>@session.DateAndTime.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@session.Instructor</td>
                <td>
                    <form asp-controller="Sessions" asp-action="Book" asp-route-id="@session.Id" method="post">
                        <button type="submit" class="btn btn-primary btn-sm">Boka</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>